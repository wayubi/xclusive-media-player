#!/usr/bin/env php
<?php
require_once __DIR__ . '/../lib/Utils.php';
require_once __DIR__ . '/../lib/MetadataExtractor.php';
require_once __DIR__ . '/../lib/MetadataDatabase.php';
require_once __DIR__ . '/../lib/AuditDatabase.php';

// Detect available CPU cores
function detect_cores(): int {
    if (function_exists('os_proc_cpu_count')) {
        $count = os_proc_cpu_count();
        if ($count > 0) return $count;
    }
    
    $result = @shell_exec('nproc');
    if ($result && is_numeric(trim($result))) {
        return (int)trim($result);
    }
    
    $result = @shell_exec('grep -c ^processor /proc/cpuinfo');
    if ($result && is_numeric(trim($result))) {
        return (int)trim($result);
    }
    
    return 4;
}

// Process a chunk of files (used by workers)
function process_chunk(array $files, int $workerId, bool $dryRun, bool $checkXxhash, bool $force, bool $showProgress): array {
    global $root;
    
    $metaDb = new MetadataDatabase();
    $total = count($files);
    $refreshed = 0;
    $skipped = 0;
    $failed = 0;
    $errors = [];
    
    foreach ($files as $i => $fsPath) {
        $filename = basename($fsPath);
        
        if ($showProgress) {
            $pct = round((($i + 1) / $total) * 100);
            $filled = (int)($pct / 5);
            $bar = str_repeat('█', $filled) . str_repeat('░', 20 - $filled);
            echo "\r[Worker " . ($workerId + 1) . "] [$bar] $pct% ";
            flush();
        }
        
        $webPath = '/volumes' . str_replace($root, '', $fsPath);
        $needsRefresh = false;
        $reason = '';
        
        if ($force) {
            $needsRefresh = true;
            $reason = 'force';
        } else {
            $metadata = $metaDb->getMetadata($webPath, $fsPath);
            
            if (!$metadata) {
                $needsRefresh = true;
                $reason = 'missing';
            } elseif ($checkXxhash) {
                $dbXxhash = $metadata['xxhash'] ?? null;
                if ($dbXxhash) {
                    $currentOutput = @shell_exec('xxhsum ' . escapeshellarg($fsPath) . ' 2>/dev/null');
                    $currentXxhash = $currentOutput ? explode(' ', trim($currentOutput))[0] ?? null : null;
                    if ($currentXxhash !== $dbXxhash) {
                        $needsRefresh = true;
                        $reason = 'xxhash mismatch';
                    }
                } else {
                    $needsRefresh = true;
                    $reason = 'xxhash missing';
                }
            }
            
            if (!$needsRefresh) {
                $skipped++;
                continue;
            }
        }
        
        if ($dryRun) {
            echo "[Worker " . ($workerId + 1) . "] $filename - Would refresh ($reason)\n";
            $refreshed++;
            continue;
        }
        
        try {
            $metaDb->deleteMetadata($fsPath);
            $output = MetadataExtractor::extract($fsPath);
            $metaDb->saveMetadata($webPath, $fsPath, $output);
            $refreshed++;
        } catch (Exception $e) {
            $failed++;
            $errors[] = "$filename: " . $e->getMessage();
            echo "[Worker " . ($workerId + 1) . "] $filename - Failed: " . $e->getMessage() . "\n";
        }
    }
    
    if ($showProgress) {
        echo "\n";
    }
    
    echo "[Worker " . ($workerId + 1) . "] Done: $refreshed refreshed, $skipped skipped, $failed failed\n";
    
    return [
        'refreshed' => $refreshed,
        'skipped' => $skipped,
        'failed' => $failed,
        'errors' => $errors
    ];
}

// Run parallel workers using pcntl_fork for real-time monitoring
function run_parallel(array $files, int $numJobs, bool $dryRun, bool $checkXxhash, bool $force, bool $showProgress): void {
    global $root;
    
    $totalFiles = count($files);
    $chunkSize = (int)ceil($totalFiles / $numJobs);
    $chunks = array_chunk($files, $chunkSize);
    
    echo "Starting $numJobs parallel workers for $totalFiles files...\n\n";
    
    if (!function_exists('pcntl_fork')) {
        // Fallback to sequential if pcntl not available
        echo "pcntl not available, running sequentially...\n";
        process_chunk($files, 0, $dryRun, $checkXxhash, $force, $showProgress);
        return;
    }
    
    $pids = [];
    $startTime = time();
    
    foreach ($chunks as $workerId => $chunk) {
        $pid = pcntl_fork();
        
        if ($pid == -1) {
            // Fork failed, process in main thread
            echo "Fork failed for worker $workerId, processing in main thread...\n";
            process_chunk($chunk, $workerId, $dryRun, $checkXxhash, $force, $showProgress);
        } elseif ($pid == 0) {
            // Child process - do work
            $result = process_chunk($chunk, $workerId, $dryRun, $checkXxhash, $force, $showProgress);
            
            // Write result to temp file for parent to collect
            $resultFile = sys_get_temp_dir() . '/refresh_result_' . getmypid() . '.json';
            file_put_contents($resultFile, json_encode($result));
            
            exit(0);
        } else {
            $pids[$pid] = $workerId;
        }
    }
    
    // Parent: wait for all children and collect results
    $totalRefreshed = 0;
    $totalSkipped = 0;
    $totalFailed = 0;
    
    foreach ($pids as $pid => $workerId) {
        $status = 0;
        pcntl_waitpid($pid, $status);
        
        // Try to collect result from child
        $resultFile = sys_get_temp_dir() . '/refresh_result_' . $pid . '.json';
        if (file_exists($resultFile)) {
            $result = json_decode(file_get_contents($resultFile), true);
            if ($result) {
                $totalRefreshed += $result['refreshed'];
                $totalSkipped += $result['skipped'];
                $totalFailed += $result['failed'];
            }
            @unlink($resultFile);
        }
    }
    
    $elapsed = time() - $startTime;
    echo "\n[Summary] $numJobs workers completed in {$elapsed}s\n";
    echo "         Total: $totalFiles files\n";
    echo "         Refreshed: $totalRefreshed, Skipped: $totalSkipped, Failed: $totalFailed\n";
}

// Parse command line arguments
$force = false;
$all = false;
$dryRun = false;
$checkXxhash = false;
$prune = false;
$refresh = false;
$showHelp = false;
$singleFile = null;
$includeAuditDb = false;
$numJobs = null;
$showProgress = false;
$workerMode = false;
$workerId = 0;
$chunkFilePath = '';

for ($i = 1; $i < count($argv); $i++) {
    $arg = $argv[$i];
    
    if (strpos($arg, '--') === 0) {
        $opt = substr($arg, 2);
        switch ($opt) {
            case 'force':
                $force = true;
                break;
            case 'all':
                $all = true;
                break;
            case 'dry-run':
                $dryRun = true;
                break;
            case 'xxhash':
                $checkXxhash = true;
                break;
            case 'prune':
                $prune = true;
                break;
            case 'refresh':
                $refresh = true;
                break;
            case 'include-audit-db':
                $includeAuditDb = true;
                break;
            case 'help':
                $showHelp = true;
                break;
            case 'jobs':
                $nextArg = $argv[$i + 1] ?? 'auto';
                $i++;
                if ($nextArg === 'auto' || $nextArg === '') {
                    $numJobs = 'auto';
                } else {
                    $numJobs = $nextArg;
                }
                if ($numJobs === 'auto') {
                    $numJobs = (string)detect_cores();
                }
                break;
            case 'progress':
                $showProgress = true;
                break;
            case 'worker':
                $workerMode = true;
                $chunkFilePath = $argv[++$i] ?? '';
                $workerId = (int)($argv[++$i] ?? 0);
                break;
            case 'dry-run':
                $dryRun = true;
                break;
        }
    } elseif (strpos($arg, '-') === 0) {
        $opts = substr($arg, 1);
        for ($j = 0; $j < strlen($opts); $j++) {
            switch ($opts[$j]) {
                case 'f':
                    $force = true;
                    break;
                case 'a':
                    $all = true;
                    break;
                case 'h':
                    $showHelp = true;
                    break;
                case 'j':
                    $numJobs = $argv[++$i] ?? 'auto';
                    break;
            }
        }
    } elseif (!$workerMode) {
        $singleFile = $arg;
    }
}

// Handle worker mode
if ($workerMode && $chunkFilePath) {
    $files = json_decode(file_get_contents($chunkFilePath), true);
    @unlink($chunkFilePath);
    
    $metaDb = new MetadataDatabase();
    $root = realpath(__DIR__ . '/../volumes');
    
    $results = process_chunk($files, $workerId, $dryRun, $checkXxhash, $force, $showProgress);
    exit(0);
}

// Show help
if ($showHelp) {
    echo <<<HELP
refresh_metadata - Manage file metadata in the SQLite database

Usage: refresh_metadata [file] [options]
       refresh_metadata [options] --jobs N

Options:
  --force      Refresh all files, even if up to date
  --all       Operate on all files under /volumes
  --dry-run   Preview changes without modifying database
  --xxhash    Verify file integrity using xxhash
  --prune     Remove stale records (deleted files)
  --include-audit-db  Also prune audit.db (with --prune)
  --refresh   After pruning, continue with refresh
  --jobs N    Run N parallel processes (default: auto-detect cores)
  --progress  Show progress bars per worker
  --help      Display this help message

Examples:
  refresh_metadata --all                    Refresh all files (auto-detect cores)
  refresh_metadata --all --jobs 8             Refresh with 8 workers
  refresh_metadata --all --jobs auto         Auto-detect CPU cores
  refresh_metadata --all --jobs 28 --progress 28 workers with progress
  refresh_metadata video.mp4 --force         Refresh single file

HELP;
    exit(0);
}

// Validate options
if ($includeAuditDb && !$prune) {
    fprintf(STDERR, "Error: --include-audit-db requires --prune\n");
    exit(1);
}

if ($singleFile !== null) {
    if (!file_exists($singleFile)) {
        fprintf(STDERR, "Error: File not found: %s\n", $singleFile);
        exit(1);
    }
    $singleFile = realpath($singleFile);
}

$root = realpath(__DIR__ . '/../volumes');
$targetDir = $all ? $root : getcwd();

// Determine number of jobs
if ($numJobs === null || $numJobs === 'auto') {
    $numJobs = detect_cores();
} else {
    $numJobs = (int)$numJobs;
}

// Prune mode (unchanged)
if ($prune) {
    echo "Pruning stale database records...\n";
    $metaDb = new MetadataDatabase();
    $pruned = 0;
    $checked = 0;
    
    $stmt = $metaDb->query('SELECT id, file_path, xxhash FROM files');
    
    while ($row = $stmt->fetchArray(SQLITE3_ASSOC)) {
        $dbFilePath = $row['file_path'];
        $filename = basename($dbFilePath);
        
        $inScope = false;
        if ($singleFile) {
            $inScope = ($dbFilePath === $singleFile);
        } elseif ($all) {
            $inScope = (strpos($dbFilePath, $root . '/') === 0);
        } else {
            $inScope = (dirname($dbFilePath) === $targetDir);
        }
        if (!$inScope) { continue; }
        
        $checked++;
        $shouldPrune = false;
        $reason = '';
        
        if (!is_file($dbFilePath)) {
            $shouldPrune = true;
            $reason = 'not-a-file';
        } elseif (!$shouldPrune) {
            $parts = explode('/', $dbFilePath);
            foreach ($parts as $part) {
                if (strlen($part) > 0 && $part[0] === '.') {
                    $shouldPrune = true;
                    $reason = 'hidden';
                    break;
                }
            }
        }
        
        if (!$shouldPrune) {
            if ($force) {
                $shouldPrune = true;
                $reason = 'force';
            } elseif (!file_exists($dbFilePath)) {
                $shouldPrune = true;
                $reason = 'missing';
            } elseif ($checkXxhash) {
                $dbXxhash = $row['xxhash'] ?? null;
                if ($dbXxhash) {
                    $currentOutput = @shell_exec('xxhsum ' . escapeshellarg($dbFilePath) . ' 2>/dev/null');
                    $currentXxhash = $currentOutput ? explode(' ', trim($currentOutput))[0] ?? null : null;
                    if ($currentXxhash !== $dbXxhash) {
                        $shouldPrune = true;
                        $reason = 'xxhash mismatch';
                    }
                } else {
                    $shouldPrune = true;
                    $reason = 'xxhash missing';
                }
            }
        }
        
        if ($shouldPrune) {
            if ($dryRun) {
                echo "[$checked] $filename - Would prune ($reason) [DRY RUN]\n";
                $pruned++;
            } else {
                try {
                    $metaDb->deleteMetadata($dbFilePath);
                    if ($includeAuditDb) {
                        $auditDb = new AuditDatabase();
                        $auditDb->deleteFile($dbFilePath);
                    }
                    echo "[$checked] $filename - Pruned ($reason)\n";
                    $pruned++;
                } catch (Exception $e) {
                    echo "[$checked] $filename - Failed: " . $e->getMessage() . "\n";
                }
            }
        }
    }
    
    echo "\n";
    if ($dryRun) {
        echo "Dry run: Would prune $pruned of $checked records.\n";
    } else {
        echo "Pruned $pruned of $checked records.\n";
    }
    
    if ($includeAuditDb && !$dryRun) {
        echo "\nPruning orphan audit records...\n";
        
        $auditDb = new AuditDatabase();
        $metaDbForOrphanCheck = new MetadataDatabase();
        $orphanPruned = 0;
        
        $metadataPaths = [];
        $metaStmt = $metaDbForOrphanCheck->getDb()->query('SELECT file_path FROM files');
        while ($metaRow = $metaStmt->fetchArray(SQLITE3_ASSOC)) {
            $metadataPaths[$metaRow['file_path']] = true;
        }
        
        $auditStmt = $auditDb->getDb()->query('SELECT file_path FROM files');
        
        while ($row = $auditStmt->fetchArray(SQLITE3_ASSOC)) {
            $dbFilePath = $row['file_path'];
            
            if (isset($metadataPaths[$dbFilePath])) {
                continue;
            }
            
            $inScope = false;
            if ($singleFile) {
                $inScope = ($dbFilePath === $singleFile);
            } elseif ($all) {
                $inScope = (strpos($dbFilePath, $root . '/') === 0);
            } else {
                $inScope = (dirname($dbFilePath) === $targetDir);
            }
            
            if ($inScope) {
                $auditDb->deleteFile($dbFilePath);
                $orphanPruned++;
            }
        }
        
        echo "Orphan audit records pruned: $orphanPruned\n";
    }
    
    if (!$refresh) {
        exit(0);
    }
    echo "\n";
}

// Scan files
if ($singleFile) {
    $files = [$singleFile];
    echo "Processing single file: " . basename($singleFile) . "\n\n";
} else {
    echo "Scanning all files under /volumes...\n";
    
    $files = [];
    if ($all) {
        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($targetDir, RecursiveDirectoryIterator::SKIP_DOTS),
            RecursiveIteratorIterator::SELF_FIRST
        );
        foreach ($iterator as $file) {
            if ($file->isFile()) {
                $path = $file->getPathname();
                $parts = explode('/', $path);
                $shouldSkip = false;
                foreach ($parts as $part) {
                    if (strlen($part) > 0 && $part[0] === '.') {
                        $shouldSkip = true;
                        break;
                    }
                }
                if (!$shouldSkip) {
                    $files[] = $path;
                }
            }
        }
    } else {
        foreach (scandir($targetDir) as $f) {
            if ($f !== '.' && $f !== '..' && $f[0] !== '.' && is_file($targetDir . '/' . $f)) {
                $files[] = $targetDir . '/' . $f;
            }
        }
    }
}

$total = count($files);
echo "Found $total files to check.\n\n";

if ($total === 0) {
    echo "No files found.\n";
    exit(0);
}

// Run in parallel if jobs > 1
if ($numJobs > 1 && !$singleFile) {
    run_parallel($files, $numJobs, $dryRun, $checkXxhash, $force, $showProgress);
    exit(0);
}

// Single-threaded mode
$metaDb = new MetadataDatabase();
$refreshed = 0;
$skipped = 0;
$failed = 0;
$errors = [];

foreach ($files as $i => $fsPath) {
    $num = $i + 1;
    $filename = basename($fsPath);
    
    if ($showProgress && $numJobs <= 1) {
        $pct = round(($num / $total) * 100);
        $filled = (int)($pct / 5);
        $bar = str_repeat('█', $filled) . str_repeat('░', 20 - $filled);
        echo "\r[$bar] $pct% ";
    }
    
    $webPath = '/volumes' . str_replace($root, '', $fsPath);
    $needsRefresh = false;
    $reason = '';
    
    if ($force) {
        $needsRefresh = true;
        $reason = 'force';
    } else {
        $metadata = $metaDb->getMetadata($webPath, $fsPath);
        
        if (!$metadata) {
            $needsRefresh = true;
            $reason = 'missing';
        } elseif ($checkXxhash) {
            $dbXxhash = $metadata['xxhash'] ?? null;
            if ($dbXxhash) {
                $currentOutput = @shell_exec('xxhsum ' . escapeshellarg($fsPath) . ' 2>/dev/null');
                $currentXxhash = $currentOutput ? explode(' ', trim($currentOutput))[0] ?? null : null;
                if ($currentXxhash !== $dbXxhash) {
                    $needsRefresh = true;
                    $reason = 'xxhash mismatch';
                }
            } else {
                $needsRefresh = true;
                $reason = 'xxhash missing';
            }
        }
        
        if (!$needsRefresh) {
            $skipped++;
            continue;
        }
    }
    
    if ($dryRun) {
        echo "[$num/$total] $filename - Would refresh ($reason) [DRY RUN]\n";
        $refreshed++;
        continue;
    }
    
    try {
        $metaDb->deleteMetadata($fsPath);
        $output = MetadataExtractor::extract($fsPath);
        $metaDb->saveMetadata($webPath, $fsPath, $output);
        
        $type = MetadataExtractor::isTextFile($fsPath) ? 'text' : 'media';
        echo "[$num/$total] $filename - Refreshed ($type)\n";
        $refreshed++;
    } catch (Exception $e) {
        $failed++;
        $errors[] = "$filename: " . $e->getMessage();
        echo "[$num/$total] $filename - Failed\n";
    }
}

echo "\n";
if ($dryRun) {
    echo "Dry run complete. $refreshed files would be refreshed, $skipped up to date, $failed failed.\n";
} else {
    echo "Refresh complete. $refreshed files refreshed, $skipped up to date, $failed failed.\n";
}

if (!empty($errors)) {
    echo "\nErrors:\n";
    foreach ($errors as $error) {
        echo "  - $error\n";
    }
}