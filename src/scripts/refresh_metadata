#!/usr/bin/env php
<?php
require_once __DIR__ . '/../lib/Utils.php';
require_once __DIR__ . '/../lib/MetadataExtractor.php';
require_once __DIR__ . '/../lib/MetadataDatabase.php';
require_once __DIR__ . '/../lib/AuditDatabase.php';

// Parse arguments manually to handle options anywhere in the command line
// (PHP's getopt doesn't reliably handle options after positional arguments)
$force = false;
$all = false;
$dryRun = false;
$checkXxhash = false;
$prune = false;
$refresh = false;
$showHelp = false;
$singleFile = null;
$includeAuditDb = false;

for ($i = 1; $i < count($argv); $i++) {
    $arg = $argv[$i];
    
    if (strpos($arg, '--') === 0) {
        $opt = substr($arg, 2);
        switch ($opt) {
            case 'force':
                $force = true;
                break;
            case 'all':
                $all = true;
                break;
            case 'dry-run':
                $dryRun = true;
                break;
            case 'xxhash':
                $checkXxhash = true;
                break;
            case 'prune':
                $prune = true;
                break;
            case 'refresh':
                $refresh = true;
                break;
            case 'include-audit-db':
                $includeAuditDb = true;
                break;
            case 'help':
                $showHelp = true;
                break;
        }
    } elseif (strpos($arg, '-') === 0) {
        // Handle short options
        $opts = substr($arg, 1);
        for ($j = 0; $j < strlen($opts); $j++) {
            switch ($opts[$j]) {
                case 'f':
                    $force = true;
                    break;
                case 'a':
                    $all = true;
                    break;
                case 'h':
                    $showHelp = true;
                    break;
            }
        }
    } else {
        // Positional argument (file)
        $singleFile = $arg;
    }
}

// Show help if requested
if ($showHelp) {
    echo <<<HELP
refresh_metadata - Manage file metadata in the SQLite database

Usage: refresh_metadata [file] [options]

Description:
  Manages file metadata database. Three modes:
  - Default (refresh): scans filesystem and adds/updates records
  - --prune: queries database and removes stale records
  - --prune --refresh: prune first, then refresh (both operations)

Arguments:
  file          Optional: specific file to refresh. If provided, processes only
                that file regardless of --all flag.

Options:
  --force      Refresh mode: refresh all files. Prune mode: remove all records
               in scope unconditionally.
  --all        Operate on all files under /volumes instead of just current directory
  --dry-run    Preview changes without modifying database
  --xxhash     Verify file integrity using xxhash (also calculates/stores xxhash
               during refresh)
  --prune      Enter prune mode (remove stale records instead of refreshing)
  --include-audit-db  Also prune audit.db when pruning (requires --prune). 
               Removes stale audit records and orphans not in metadata.db.
  --refresh    After pruning, continue with refresh mode (use with --prune to do both)
  --help       Display this help message

Examples:
  refresh_metadata              Refresh current directory, skip existing
  refresh_metadata video.mp4    Refresh single file
  refresh_metadata --force      Force refresh all files in current directory
  refresh_metadata --all        Refresh all files under /volumes
  refresh_metadata --prune      Remove records for deleted files in current dir
  refresh_metadata --prune --include-audit-db   Prune metadata.db and audit.db
  refresh_metadata --prune --include-audit-db --all   Prune both databases for all files
  refresh_metadata --prune --refresh --all Prune stale records, then refresh all files
  refresh_metadata video.mp4 --xxhash --force  Force refresh single file

HELP;
    exit(0);
}

// Validate --include-audit-db requires --prune
if ($includeAuditDb && !$prune) {
    fprintf(STDERR, "Error: --include-audit-db requires --prune to be specified\n");
    exit(1);
}

// Validate single file if provided
if ($singleFile !== null) {
    if (!file_exists($singleFile)) {
        fprintf(STDERR, "Error: File not found: %s\n", $singleFile);
        exit(1);
    }
    $singleFile = realpath($singleFile);
}

// Determine target directory
$root = realpath(__DIR__ . '/../volumes');
$targetDir = $all ? $root : getcwd();

// Handle prune mode
if ($prune) {
    echo "Pruning stale database records...\n";
    
    $metaDb = new MetadataDatabase();
    $pruned = 0;
    $checked = 0;
    
    // Get all records from database
    $stmt = $metaDb->query('SELECT id, file_path, xxhash FROM files');
    
    while ($row = $stmt->fetchArray(SQLITE3_ASSOC)) {
        $dbFilePath = $row['file_path'];
        $filename = basename($dbFilePath);
        
        // Check if record is in scope
        $inScope = false;
        if ($singleFile) {
            // Single file mode: only check the specified file
            $inScope = ($dbFilePath === $singleFile);
        } elseif ($all) {
            $inScope = (strpos($dbFilePath, $root . '/') === 0);
        } else {
            $inScope = (dirname($dbFilePath) === $targetDir);
        }
        if (!$inScope) { continue; }
        
        $checked++;
        $shouldPrune = false;
        $reason = '';
        
        // Prune non-files (directories)
        if (!is_file($dbFilePath)) {
            $shouldPrune = true;
            $reason = 'not-a-file';
        }
        // Prune hidden files/directories (any path component starting with .)
        elseif (!$shouldPrune) {
            $parts = explode('/', $dbFilePath);
            foreach ($parts as $part) {
                if (strlen($part) > 0 && $part[0] === '.') {
                    $shouldPrune = true;
                    $reason = 'hidden';
                    break;
                }
            }
        }
        
        if (!$shouldPrune) {
            if ($force) {
                $shouldPrune = true;
                $reason = 'force';
            } elseif (!file_exists($dbFilePath)) {
                $shouldPrune = true;
                $reason = 'missing';
            } elseif ($checkXxhash) {
                // Check xxhash
                $dbXxhash = $row['xxhash'] ?? null;
                if ($dbXxhash) {
                    $currentXxhashOutput = Utils::executeCommand('xxhsum ' . escapeshellarg($dbFilePath));
                    $currentXxhash = null;
                    if ($currentXxhashOutput) {
                        $parts = explode(' ', trim($currentXxhashOutput));
                        $currentXxhash = $parts[0] ?? null;
                    }
                    if ($currentXxhash !== $dbXxhash) {
                        $shouldPrune = true;
                        $reason = 'xxhash mismatch';
                    }
                } else {
                    $shouldPrune = true;
                    $reason = 'xxhash missing';
                }
            }
        }
        
        if ($shouldPrune) {
            if ($dryRun) {
                echo "[$checked] $filename - Would prune ($reason) [DRY RUN]\n";
                $pruned++;
            } else {
                try {
                    $metaDb->deleteMetadata($dbFilePath);
                    if ($includeAuditDb) {
                        $auditDb = new AuditDatabase();
                        $auditDb->deleteFile($dbFilePath);
                    }
                    echo "[$checked] $filename - Pruned ($reason)\n";
                    $pruned++;
                } catch (Exception $e) {
                    echo "[$checked] $filename - Failed to prune: " . $e->getMessage() . "\n";
                }
            }
        }
    }
    
    echo "\n";
    if ($dryRun) {
        echo "Dry run complete. Would prune $pruned of $checked records.\n";
    } else {
        echo "Pruning complete. Removed $pruned of $checked records.\n";
    }
    
    // Prune orphan audit records (files in audit.db but not in metadata.db)
    if ($includeAuditDb && !$dryRun) {
        echo "\nPruning orphan audit records...\n";
        
        $auditDb = new AuditDatabase();
        $metaDbForOrphanCheck = new MetadataDatabase();
        $orphanPruned = 0;
        
        // Get all file paths from metadata.db into an array for quick lookup
        $metadataPaths = [];
        $metaStmt = $metaDbForOrphanCheck->getDb()->query('SELECT file_path FROM files');
        while ($metaRow = $metaStmt->fetchArray(SQLITE3_ASSOC)) {
            $metadataPaths[$metaRow['file_path']] = true;
        }
        
        // Query audit.db files and check if they exist in metadata.db
        $auditStmt = $auditDb->getDb()->query('SELECT file_path FROM files');
        
        while ($row = $auditStmt->fetchArray(SQLITE3_ASSOC)) {
            $dbFilePath = $row['file_path'];
            
            // Skip if file exists in metadata.db
            if (isset($metadataPaths[$dbFilePath])) {
                continue;
            }
            
            // Apply same scope logic
            $inScope = false;
            if ($singleFile) {
                $inScope = ($dbFilePath === $singleFile);
            } elseif ($all) {
                $inScope = (strpos($dbFilePath, $root . '/') === 0);
            } else {
                $inScope = (dirname($dbFilePath) === $targetDir);
            }
            
            if ($inScope) {
                $auditDb->deleteFile($dbFilePath);
                $orphanPruned++;
            }
        }
        
        echo "Orphan audit records pruned: $orphanPruned\n";
    }
    
    if (!$refresh) {
        exit(0);
    }
    echo "\n";
}

// Continue to refresh mode if --refresh was specified

// Handle single file mode
if ($singleFile) {
    $files = [$singleFile];
    echo "Processing single file: " . basename($singleFile) . "\n\n";
} else {
    echo "Scanning all files under /volumes...\n";
    
    // Get all files
    $files = [];
    if ($all) {
        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($targetDir, RecursiveDirectoryIterator::SKIP_DOTS),
            RecursiveIteratorIterator::SELF_FIRST
        );
        foreach ($iterator as $file) {
            if ($file->isFile()) {
                $path = $file->getPathname();
                // Skip if any directory component or filename starts with "."
                $parts = explode('/', $path);
                $shouldSkip = false;
                foreach ($parts as $part) {
                    if (strlen($part) > 0 && $part[0] === '.') {
                        $shouldSkip = true;
                        break;
                    }
                }
                if (!$shouldSkip) {
                    $files[] = $path;
                }
            }
        }
    } else {
        foreach (scandir($targetDir) as $f) {
            if ($f !== '.' && $f !== '..' && $f[0] !== '.' && is_file($targetDir . '/' . $f)) {
                $files[] = $targetDir . '/' . $f;
            }
        }
    }
}

$total = count($files);
echo "Found $total files to check.\n\n";

if ($total === 0) {
    echo "No files found.\n";
    exit(0);
}

$metaDb = new MetadataDatabase();
$refreshed = 0;
$skipped = 0;
$failed = 0;
$errors = [];

foreach ($files as $i => $fsPath) {
    $num = $i + 1;
    $filename = basename($fsPath);
    
    // Convert to web path
    $webPath = '/volumes' . str_replace($root, '', $fsPath);
    
    // Check if refresh is needed
    $needsRefresh = false;
    $reason = '';
    
    if ($force) {
        $needsRefresh = true;
        $reason = 'force';
    } else {
        $metadata = $metaDb->getMetadata($webPath, $fsPath);
        
        if (!$metadata) {
            $needsRefresh = true;
            $reason = 'missing';
        } elseif ($checkXxhash) {
            // Check if xxhash has changed
            $dbXxhash = $metadata['xxhash'] ?? null;
            if ($dbXxhash) {
                $currentXxhashOutput = Utils::executeCommand('xxhsum ' . escapeshellarg($fsPath));
                $currentXxhash = null;
                if ($currentXxhashOutput) {
                    $xxhashParts = explode(' ', trim($currentXxhashOutput));
                    $currentXxhash = $xxhashParts[0] ?? null;
                }
                if ($currentXxhash !== $dbXxhash) {
                    $needsRefresh = true;
                    $reason = 'xxhash mismatch';
                }
            } else {
                // No xxhash stored, needs refresh
                $needsRefresh = true;
                $reason = 'xxhash missing';
            }
        }
        // If not force and metadata exists (and no xxhash check or xxhash matches), skip
        if (!$needsRefresh) {
            $skipped++;
            continue;
        }
    }
    
    if ($dryRun) {
        echo "[$num/$total] $filename - Would refresh ($reason) [DRY RUN]\n";
        $refreshed++;
        continue;
    }
    
    try {
        // Delete existing metadata
        $metaDb->deleteMetadata($fsPath);
        
        // Use MetadataExtractor to get metadata
        $output = MetadataExtractor::extract($fsPath);
        $metaDb->saveMetadata($webPath, $fsPath, $output);
        
        $type = MetadataExtractor::isTextFile($fsPath) ? 'text' : 'media';
        echo "[$num/$total] $filename - Refreshed ($type)\n";
        $refreshed++;
    } catch (Exception $e) {
        $failed++;
        $errors[] = "$filename: " . $e->getMessage();
        echo "[$num/$total] $filename - Failed\n";
    }
}

echo "\n";
if ($dryRun) {
    echo "Dry run complete. $refreshed files would be refreshed, $skipped up to date, $failed failed.\n";
} else {
    echo "Refresh complete. $refreshed files refreshed, $skipped up to date, $failed failed.\n";
}

if (!empty($errors)) {
    echo "\nErrors encountered:\n";
    foreach ($errors as $error) {
        echo "  - $error\n";
    }
}
