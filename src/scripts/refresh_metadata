#!/usr/bin/env php
<?php
require_once __DIR__ . '/../lib/Utils.php';
require_once __DIR__ . '/../lib/MetadataExtractor.php';
require_once __DIR__ . '/../lib/MetadataDatabase.php';
require_once __DIR__ . '/../lib/AuditDatabase.php';
require_once __DIR__ . '/../lib/FavoritesDatabase.php';

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

function detect_cores(): int {
    if (function_exists('os_proc_cpu_count')) {
        $n = os_proc_cpu_count();
        if ($n > 0) return $n;
    }
    foreach (['nproc', 'grep -c ^processor /proc/cpuinfo'] as $cmd) {
        $r = @shell_exec($cmd);
        if ($r && is_numeric(trim($r))) return (int)trim($r);
    }
    return 4;
}

function run_sequential(array &$files, bool $dryRun, bool $checkXxhash, bool $force, bool $showProgress, bool $verbose = false): array {
    global $root;
    $total     = count($files);
    $metaDb    = new MetadataDatabase();
    $refreshed = $skipped = $failed = $moved = 0;
    $errors    = [];

    foreach ($files as $i => $fsPath) {
        $num      = $i + 1;
        $filename = basename($fsPath);

        if ($showProgress) {
            $pct    = round(($num / $total) * 100);
            $filled = (int)($pct / 5);
            $bar    = str_repeat('█', $filled) . str_repeat('░', 20 - $filled);
            echo "\r[$bar] $pct% ";
        }

        $webPath      = '/volumes' . str_replace($root, '', $fsPath);
        $needsRefresh = false;
        $reason       = '';

        if ($force) {
            $needsRefresh = true;
            $reason       = 'force';
        } else {
            $metadata = $metaDb->getMetadata($webPath, $fsPath);
            if (!$metadata) {
                $needsRefresh = true;
                $reason       = 'missing';
            } elseif ($checkXxhash) {
                $dbXxhash = $metadata['xxhash'] ?? null;
                if (!$dbXxhash) {
                    $needsRefresh = true;
                    $reason       = 'xxhash missing';
                } else {
                    $out         = @shell_exec('xxhsum ' . escapeshellarg($fsPath) . ' 2>/dev/null');
                    $currentHash = $out ? explode(' ', trim($out))[0] : null;
                    if ($currentHash !== $dbXxhash) {
                        $needsRefresh = true;
                        $reason       = 'xxhash mismatch';
                    }
                }
            }
        }

        if (!$needsRefresh) {
            if ($verbose) echo "[$num/$total] $filename - Skipped\n";
            $skipped++;
            continue;
        }

        if ($dryRun) {
            echo "[$num/$total] $filename - Would refresh ($reason) [DRY RUN]\n";
            $refreshed++;
            continue;
        }

        // Move detection: missing file might be a renamed/moved file
        if ($reason === 'missing') {
            try {
                $fsSize = @filesize($fsPath);
                $fsMtime = @filemtime($fsPath);
                $output = MetadataExtractor::extract($fsPath);
                $xxhashOut = @shell_exec('xxhsum ' . escapeshellarg($fsPath) . ' 2>/dev/null');
                $xxhash = $xxhashOut ? explode(' ', trim($xxhashOut))[0] : null;

                if ($xxhash && $fsSize !== false && $fsMtime !== false) {
                    $candidate = $metaDb->findMoveCandidate($xxhash, $fsSize, $fsMtime, $fsPath);
                    if ($candidate) {
                        $metaDb->updateFilePaths((int)$candidate['id'], $fsPath, $webPath);
                        echo "[$num/$total] $filename - Moved ({$candidate['file_path']})\n";
                        $moved++;
                        continue;
                    }
                }
            } catch (Exception $e) {
                // Move check failed — fall through to normal refresh
            }
        }

        try {
            if (!isset($output)) {
                $output = MetadataExtractor::extract($fsPath);
            }
            $metaDb->saveMetadata($webPath, $fsPath, $output);
            $type  = MetadataExtractor::isTextFile($fsPath) ? 'text' : 'media';
            echo "[$num/$total] $filename - Refreshed ($type)\n";
            $refreshed++;
        } catch (Exception $e) {
            $failed++;
            $errors[] = "$filename: " . $e->getMessage();
            echo "[$num/$total] $filename - Failed\n";
        }
    }

    if ($showProgress) echo "\n";

    return ['refreshed' => $refreshed, 'skipped' => $skipped, 'failed' => $failed, 'moved' => $moved, 'errors' => $errors];
}

function run_parallel(array &$files, int $numJobs, bool $dryRun, bool $checkXxhash, bool $force, bool $showProgress, bool $verbose = false): void {
    global $root;
    $totalFiles = count($files);

    if (!function_exists('pcntl_fork')) {
        echo "pcntl not available, running sequentially...\n";
        run_sequential($files, $dryRun, $checkXxhash, $force, $showProgress, $verbose);
        return;
    }

    echo "Starting $numJobs parallel workers for $totalFiles files...\n\n";

    // Break up filesystem-order clustering: files needing a refresh are often
    // concentrated in a single recently-added directory, which appears as a
    // contiguous block in the recursive scan. Without shuffling, only the
    // workers whose batches happen to cover that block do any real work.
    // Shuffling spreads refresh candidates evenly across all workers' batches.
    shuffle($files);

    // Counter file lives in tmpfs (in-memory on most Linux systems).
    // Namespaced by PID to allow concurrent script invocations without collision.
    $counterFile = '/tmp/refresh_counter_' . getmypid() . '.txt';
    file_put_contents($counterFile, '0');

    // Grab this many indices per lock acquisition to reduce flock contention.
    $batchSize = 50;

    $pids      = [];
    $startTime = time();

    for ($i = 0; $i < $numJobs; $i++) {
        // Stream socket pair: zero disk I/O, kernel-buffered, used to return
        // per-worker results to the parent without any tmp files.
        $sockPair = stream_socket_pair(STREAM_PF_UNIX, STREAM_SOCK_STREAM, STREAM_IPPROTO_IP);

        $pid = pcntl_fork();
        if ($pid === -1) {
            echo "Fork failed for worker $i\n";
            fclose($sockPair[0]);
            fclose($sockPair[1]);
            continue;
        }

        if ($pid === 0) {
            // ----- Child worker -----
            fclose($sockPair[0]); // close parent-side socket

            // One DB connection per worker, not per file.
            $metaDb          = new MetadataDatabase();
            $workerRefreshed = 0;
            $workerSkipped   = 0;
            $workerFailed    = 0;
            $workerMoved     = 0;

            while (true) {
                // Atomically grab the next batch of file indices.
                $fp = fopen($counterFile, 'c+');
                flock($fp, LOCK_EX);
                $index = (int)fgets($fp);
                if ($index >= $totalFiles) {
                    flock($fp, LOCK_UN);
                    fclose($fp);
                    break;
                }
                $batchEnd = min($index + $batchSize, $totalFiles);
                ftruncate($fp, 0);
                rewind($fp);
                fwrite($fp, $batchEnd);
                flock($fp, LOCK_UN);
                fclose($fp);

                for ($j = $index; $j < $batchEnd; $j++) {
                    $fsPath  = $files[$j];
                    $webPath = '/volumes' . str_replace($root, '', $fsPath);

                    if ($force) {
                        $needsRefresh = true;
                    } else {
                        $metadata     = $metaDb->getMetadata($webPath, $fsPath);
                        $needsRefresh = !$metadata;

                        if (!$needsRefresh && $checkXxhash) {
                            $dbXxhash = $metadata['xxhash'] ?? null;
                            if (!$dbXxhash) {
                                $needsRefresh = true;
                            } else {
                                $out          = @shell_exec('xxhsum ' . escapeshellarg($fsPath) . ' 2>/dev/null');
                                $currentHash  = $out ? explode(' ', trim($out))[0] : null;
                                $needsRefresh = ($currentHash !== $dbXxhash);
                            }
                        }
                    }

                    if ($needsRefresh) {
                        if ($dryRun) {
                            if ($verbose) echo "[$i] " . basename($fsPath) . " - Would refresh\n";
                            $workerRefreshed++;
                        } else {
                            if (!$metadata && !$force) {
                                try {
                                    $fsSize = @filesize($fsPath);
                                    $fsMtime = @filemtime($fsPath);
                                    $output = MetadataExtractor::extract($fsPath);
                                    $xxhashOut = @shell_exec('xxhsum ' . escapeshellarg($fsPath) . ' 2>/dev/null');
                                    $xxhash = $xxhashOut ? explode(' ', trim($xxhashOut))[0] : null;
                                    if ($xxhash && $fsSize !== false && $fsMtime !== false) {
                                        $candidate = $metaDb->findMoveCandidate($xxhash, $fsSize, $fsMtime, $fsPath);
                                        if ($candidate) {
                                            $metaDb->updateFilePaths((int)$candidate['id'], $fsPath, $webPath);
                                            if ($verbose) echo "[$i] " . basename($fsPath) . " - Moved\n";
                                            $workerMoved++;
                                            continue;
                                        }
                                    }
                                } catch (Exception $e) {}
                            }

                            try {
                                if (!isset($output)) {
                                    $output = MetadataExtractor::extract($fsPath);
                                }
                                $metaDb->saveMetadata($webPath, $fsPath, $output);
                                if ($verbose) {
                                    $type = MetadataExtractor::isTextFile($fsPath) ? 'text' : 'media';
                                    echo "[$i] " . basename($fsPath) . " - Refreshed ($type)\n";
                                }
                                $workerRefreshed++;
                            } catch (Exception $e) {
                                if ($verbose) echo "[$i] " . basename($fsPath) . " - Failed: " . $e->getMessage() . "\n";
                                $workerFailed++;
                            }
                        }
                    } else {
                        $workerSkipped++;
                    }
                }

                if ($showProgress) {
                    $pct = round(($batchEnd / $totalFiles) * 100);
                    echo "[$i] $pct% ($batchEnd/$totalFiles)\n";
                }
            }

            echo "[$i] Done: $workerRefreshed refreshed, $workerSkipped skipped, $workerFailed failed\n";

            // Send results to parent over the socket (no tmp file).
            fwrite($sockPair[1], json_encode(['r' => $workerRefreshed, 's' => $workerSkipped, 'f' => $workerFailed, 'm' => $workerMoved]) . "\n");
            fclose($sockPair[1]);
            exit(0);
        }

        // ----- Parent -----
        fclose($sockPair[1]); // close child-side socket
        $pids[$pid] = $sockPair[0];
    }

    $totalRefreshed = 0;
    $totalSkipped   = 0;
    $totalFailed    = 0;
    $totalMoved     = 0;

    foreach ($pids as $pid => $sock) {
        pcntl_waitpid($pid, $status);
        $line = fgets($sock);
        fclose($sock);
        if ($line) {
            $r = json_decode(trim($line), true) ?? [];
            $totalRefreshed += $r['r'] ?? 0;
            $totalSkipped   += $r['s'] ?? 0;
            $totalFailed    += $r['f'] ?? 0;
            $totalMoved     += $r['m'] ?? 0;
        }
    }

    @unlink($counterFile);

    $elapsed = time() - $startTime;
    echo "\n[Summary] $numJobs workers | {$elapsed}s elapsed\n";
    echo "         Total: $totalFiles | Refreshed: $totalRefreshed | Skipped: $totalSkipped | Moved: $totalMoved | Failed: $totalFailed\n";
}

// ---------------------------------------------------------------------------
// Argument parsing
// ---------------------------------------------------------------------------

$force          = false;
$all            = false;
$noSubfolders   = false;
$dryRun         = false;
$checkXxhash    = false;
$prune          = true;
$refresh       = true;
$showHelp       = false;
$singleFile        = null;
$includeAuditDb    = false;
$includeFavoritesDb = false;
$numJobs           = null;
$showProgress   = false;
$verbose        = false;

for ($i = 1; $i < count($argv); $i++) {
    $arg = $argv[$i];
    if (str_starts_with($arg, '--')) {
        switch (substr($arg, 2)) {
            case 'force':            $force          = true; break;
            case 'all':              $all            = true; break;
            case 'no-subfolders':    $noSubfolders   = true; break;
            case 'dry-run':          $dryRun         = true; break;
            case 'xxhash':           $checkXxhash    = true; break;
            case 'prune':            $prune     = true; $refresh = false; break;
            case 'refresh':         $refresh  = true; $prune    = false; break;
            case 'no-prune':         $prune          = false; break;
            case 'no-refresh':       $refresh       = false; break;
            case 'include-audit-db':     $includeAuditDb    = true; break;
            case 'include-favorites-db': $includeFavoritesDb = true; break;
            case 'progress':         $showProgress   = true; break;
            case 'verbose':          $verbose        = true; break;
            case 'help':             $showHelp       = true; break;
            case 'jobs':
                $next    = $argv[$i + 1] ?? '';
                $numJobs = ($next === '' || $next === 'auto' || str_starts_with($next, '-'))
                    ? detect_cores()
                    : (int)$next;
                if (!str_starts_with($next, '-') && $next !== '') $i++;
                break;
        }
    } elseif (str_starts_with($arg, '-')) {
        $opts = substr($arg, 1);
        for ($j = 0; $j < strlen($opts); $j++) {
            switch ($opts[$j]) {
                case 'f': $force       = true; break;
                case 'a': $all         = true; break;
                case 'n': $noSubfolders = true; break;
                case 'h': $showHelp    = true; break;
                case 'v': $verbose     = true; break;
                case 'p': $prune       = true; break;
                case 'r': $refresh    = true; break;
                case 'j':
                    $next    = $argv[++$i] ?? 'auto';
                    $numJobs = ($next === 'auto') ? detect_cores() : (int)$next;
                    break;
            }
        }
    } else {
        $singleFile = $arg;
    }
}

if ($numJobs === null) {
    $numJobs = detect_cores();
}

// ---------------------------------------------------------------------------
// Help
// ---------------------------------------------------------------------------

if ($showHelp) {
    echo <<<HELP
refresh_metadata - Manage file metadata in the SQLite database

Usage: refresh_metadata [file] [options]

Options:
  --force              Refresh all files, even if up to date
  --all                Operate on all files under /volumes
  --no-subfolders       Only process current directory (no subdirectories)
  --dry-run            Preview changes without modifying database
  --xxhash             Verify file integrity using xxhash
  --prune              Remove stale records only (skip refresh)
  --no-prune           Skip pruning (only do refresh)
  --include-audit-db     Also prune audit.db (requires --prune)
  --include-favorites-db  Also prune favorites.db (requires --prune)
  --refresh            Run refresh only (skip prune)
  --no-refresh        Skip refresh (only do prune)
  --jobs N|auto        Run N parallel processes (default: auto-detect cores)
  --progress           Show progress per worker
  --verbose            Print each file as it is refreshed or failed
  --help               Display this help message

Notes:
  By default, BOTH prune and refresh are run on current directory + subdirectories.
  Use --all to operate on all files under /volumes.
  Use --no-subfolders to only scan the current directory (no recursion).

Short options: -f (force), -a (all), -n (no-subfolders), -h (help), -j N (jobs), -v (verbose)

Examples:
  refresh_metadata                   Prune + refresh current dir + subdirs
  refresh_metadata --all            Prune + refresh all under volumes
  refresh_metadata --no-subfolders   Prune + refresh current directory only
  refresh_metadata --prune           Prune only (skip refresh)
  refresh_metadata --refresh        Refresh only (skip prune)
  refresh_metadata --all --jobs 8     Prune + refresh with 8 workers

HELP;
    exit(0);
}

// ---------------------------------------------------------------------------
// Validation
// ---------------------------------------------------------------------------

if ($includeAuditDb && !$prune) {
    fprintf(STDERR, "Error: --include-audit-db requires --prune\n");
    exit(1);
}

if ($includeFavoritesDb && !$prune) {
    fprintf(STDERR, "Error: --include-favorites-db requires --prune\n");
    exit(1);
}

if ($all && $noSubfolders) {
    fprintf(STDERR, "Error: cannot use --all with --no-subfolders\n");
    exit(1);
}

if ($singleFile !== null) {
    if (!file_exists($singleFile)) {
        fprintf(STDERR, "Error: File not found: %s\n", $singleFile);
        exit(1);
    }
    $singleFile = realpath($singleFile);
}

$root      = realpath(__DIR__ . '/../volumes');
$targetDir = $all ? $root : getcwd();
$recursive = !$noSubfolders;

// ---------------------------------------------------------------------------
// Prune mode
// ---------------------------------------------------------------------------

if ($prune) {
    echo "Pruning stale database records...\n";
    $metaDb  = new MetadataDatabase();
    $pruned  = 0;
    $checked = 0;

    $stmt = $metaDb->query('SELECT id, file_path, xxhash FROM files');

    while ($row = $stmt->fetchArray(SQLITE3_ASSOC)) {
        $dbFilePath = $row['file_path'];

        $inScope = $singleFile
            ? ($dbFilePath === $singleFile)
            : ($all
                ? str_starts_with($dbFilePath, $root . '/')
                : ($noSubfolders
                    ? (dirname($dbFilePath) === $targetDir)
                    : str_starts_with($dbFilePath, $targetDir . '/')));

        if (!$inScope) continue;

        $checked++;
        $shouldPrune = false;
        $reason      = '';

        if (!is_file($dbFilePath)) {
            if ($row['xxhash']) {
                continue;
            }
            $shouldPrune = true;
            $reason      = 'not-a-file';
        } else {
            foreach (explode('/', $dbFilePath) as $part) {
                if ($part !== '' && $part[0] === '.') {
                    $shouldPrune = true;
                    $reason      = 'hidden';
                    break;
                }
            }
        }

        if (!$shouldPrune) {
            if ($force) {
                $shouldPrune = true;
                $reason      = 'force';
            } elseif ($checkXxhash) {
                $dbXxhash = $row['xxhash'] ?? null;
                if (!$dbXxhash) {
                    $shouldPrune = true;
                    $reason      = 'xxhash missing';
                } else {
                    $out         = @shell_exec('xxhsum ' . escapeshellarg($dbFilePath) . ' 2>/dev/null');
                    $currentHash = $out ? explode(' ', trim($out))[0] : null;
                    if ($currentHash !== $dbXxhash) {
                        $shouldPrune = true;
                        $reason      = 'xxhash mismatch';
                    }
                }
            }
        }

        if (!$shouldPrune) continue;

        $filename = basename($dbFilePath);

        if ($dryRun) {
            echo "[$checked] $filename - Would prune ($reason) [DRY RUN]\n";
            $pruned++;
        } else {
            try {
                if ($includeAuditDb) {
                    (new AuditDatabase())->deleteFile($dbFilePath);
                }
                if ($includeFavoritesDb) {
                    (new FavoritesDatabase())->removeFavorite($dbFilePath);
                }
                $metaDb->deleteMetadata($dbFilePath);
                echo "[$checked] $filename - Pruned ($reason)\n";
                $pruned++;
            } catch (Exception $e) {
                echo "[$checked] $filename - Failed: " . $e->getMessage() . "\n";
            }
        }
    }

    echo "\n";
    echo $dryRun
        ? "Dry run: Would prune $pruned of $checked records.\n"
        : "Pruned $pruned of $checked records.\n";

    if ($includeAuditDb && !$dryRun) {
        echo "\nPruning orphan audit records...\n";

        $auditDb      = new AuditDatabase();
        $metaDbCheck  = new MetadataDatabase();
        $orphanPruned = 0;

        $metaIds = [];
        $metaStmt = $metaDbCheck->getDb()->query('SELECT id FROM files');
        while ($r = $metaStmt->fetchArray(SQLITE3_ASSOC)) {
            $metaIds[(int)$r['id']] = true;
        }

        $auditStmt = $auditDb->getDb()->query('SELECT metadata_file_id FROM audit_log');
        while ($row = $auditStmt->fetchArray(SQLITE3_ASSOC)) {
            $mid = (int)$row['metadata_file_id'];
            if (isset($metaIds[$mid])) continue;

            $delStmt = $auditDb->getDb()->prepare('DELETE FROM audit_log WHERE metadata_file_id = :id');
            $delStmt->bindValue(':id', $mid, SQLITE3_INTEGER);
            $delStmt->execute();
            $orphanPruned++;
        }

        echo "Orphan audit records pruned: $orphanPruned\n";
    }

    if ($includeFavoritesDb && !$dryRun) {
        echo "\nPruning orphan favorite records...\n";

        $favDb       = new FavoritesDatabase();
        $metaDbCheck = new MetadataDatabase();
        $orphanPruned = 0;

        $metaXxhashes = [];
        $metaStmt = $metaDbCheck->getDb()->query('SELECT xxhash FROM files WHERE xxhash IS NOT NULL');
        while ($r = $metaStmt->fetchArray(SQLITE3_ASSOC)) {
            $metaXxhashes[$r['xxhash']] = true;
        }

        $favStmt = $favDb->getDb()->query('SELECT DISTINCT xxhash FROM favorites');
        while ($row = $favStmt->fetchArray(SQLITE3_ASSOC)) {
            $xxhash = $row['xxhash'];
            if (isset($metaXxhashes[$xxhash])) continue;

            $delStmt = $favDb->getDb()->prepare('DELETE FROM favorites WHERE xxhash = :xxhash');
            $delStmt->bindValue(':xxhash', $xxhash, SQLITE3_TEXT);
            $delStmt->execute();
            $orphanPruned++;
        }

        echo "Orphan favorite records pruned: $orphanPruned\n";
    }

    if (!$refresh) exit(0);
    echo "\n";
}

// ---------------------------------------------------------------------------
// File scanning
// ---------------------------------------------------------------------------

if ($singleFile) {
    $files = [$singleFile];
    echo "Processing single file: " . basename($singleFile) . "\n\n";
} else {
    echo "Scanning files...\n";
    $files = [];

    if ($all) {
        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($targetDir, RecursiveDirectoryIterator::SKIP_DOTS)
        );
        foreach ($iterator as $file) {
            if (!$file->isFile()) continue;
            $parts = explode('/', $file->getPathname());
            $skip  = false;
            foreach ($parts as $part) {
                if ($part !== '' && $part[0] === '.') { $skip = true; break; }
            }
            if (!$skip) $files[] = $file->getPathname();
        }
    } elseif ($noSubfolders) {
        foreach (scandir($targetDir) as $f) {
            if ($f[0] !== '.' && is_file("$targetDir/$f")) {
                $files[] = "$targetDir/$f";
            }
        }
    } else {
        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($targetDir, RecursiveDirectoryIterator::SKIP_DOTS)
        );
        foreach ($iterator as $file) {
            if (!$file->isFile()) continue;
            $parts = explode('/', $file->getPathname());
            $skip  = false;
            foreach ($parts as $part) {
                if ($part !== '' && $part[0] === '.') { $skip = true; break; }
            }
            if (!$skip) $files[] = $file->getPathname();
        }
    }
}

$total = count($files);
echo "Found $total files to check.\n\n";

if ($total === 0) {
    echo "No files found.\n";
    exit(0);
}

// ---------------------------------------------------------------------------
// Cleanup orphan metadata rows after refresh
// ---------------------------------------------------------------------------

function cleanup_orphans(bool $dryRun, bool $verbose = false): int {
    $metaDb         = new MetadataDatabase();
    $favDb          = new FavoritesDatabase();
    $auditDb        = new AuditDatabase();
    $cleaned        = 0;

    // Find metadata rows where file no longer exists on disk
    $result = $metaDb->query("SELECT id, file_path, xxhash FROM files WHERE xxhash IS NOT NULL AND xxhash != ''");

    while ($row = $result->fetchArray(SQLITE3_ASSOC)) {
        if (file_exists($row['file_path'])) continue;

        $xxhash = $row['xxhash'];
        $id     = (int)$row['id'];

        // Check if xxhash is found in favorites — skip if so (orphan reachable via fav)
        $favStmt = $favDb->getDb()->prepare('SELECT COUNT(*) as cnt FROM favorites WHERE xxhash = :xxhash');
        $favStmt->bindValue(':xxhash', $xxhash, SQLITE3_TEXT);
        $favResult = $favStmt->execute();
        $favRow = $favResult->fetchArray(SQLITE3_ASSOC);
        if ($favRow && $favRow['cnt'] > 0) continue;

        if ($dryRun) {
            echo "  Would delete orphan metadata #{$id}: {$row['file_path']}\n";
            $cleaned++;
            continue;
        }

        try {
            // Delete audit entries referencing this metadata_file_id
            $delStmt = $auditDb->getDb()->prepare('DELETE FROM audit_log WHERE metadata_file_id = :id');
            $delStmt->bindValue(':id', $id, SQLITE3_INTEGER);
            $delStmt->execute();
            // Delete favorites for this xxhash
            $favDel = $favDb->getDb()->prepare('DELETE FROM favorites WHERE xxhash = :xxhash');
            $favDel->bindValue(':xxhash', $xxhash, SQLITE3_TEXT);
            $favDel->execute();
            // Delete metadata
            $metaDb->deleteMetadata($row['file_path']);
            $cleaned++;
            if ($verbose) echo "  Deleted orphan metadata #{$id}: {$row['file_path']}\n";
        } catch (Exception $e) {
            echo "  Error cleaning #{$id}: {$e->getMessage()}\n";
        }
    }

    return $cleaned;
}

// ---------------------------------------------------------------------------
// Refresh (only if $refresh is true)
// ---------------------------------------------------------------------------

if ($refresh) {
    if ($numJobs > 1 && !$singleFile) {
        run_parallel($files, $numJobs, $dryRun, $checkXxhash, $force, $showProgress, $verbose);
        if (!$dryRun) {
            echo "\n";
            $cleaned = cleanup_orphans(false, $verbose);
            echo "Cleanup: $cleaned orphan metadata rows removed.\n";
        }
        exit(0);
    }

    $result = run_sequential($files, $dryRun, $checkXxhash, $force, $showProgress, $verbose);

    echo "\n";
    if ($dryRun) {
        echo "Dry run complete. {$result['refreshed']} files would be refreshed, {$result['skipped']} up to date, {$result['failed']} failed.\n";
    } else {
        echo "Refresh complete. {$result['refreshed']} files refreshed, {$result['skipped']} up to date, {$result['moved']} moved, {$result['failed']} failed.\n";
        $cleaned = cleanup_orphans(false, $verbose);
        echo "Cleanup: $cleaned orphan metadata rows removed.\n";
    }

    if (!empty($result['errors'])) {
        echo "\nErrors:\n";
        foreach ($result['errors'] as $e) echo "  - $e\n";
    }
}
