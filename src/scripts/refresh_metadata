#!/usr/bin/env php
<?php
require_once '/var/www/html/lib/Utils.php';
require_once '/var/www/html/lib/MetadataDatabase.php';

// Parse arguments
$options = getopt('', ['force', 'all', 'dry-run', 'xxhash', 'prune', 'help']);

// Show help if requested
if (isset($options['help'])) {
    echo <<<HELP
refresh_metadata - Manage file metadata in the SQLite database

Usage: refresh_metadata [options]

Description:
  Manages file metadata database. Two modes: refresh (default) scans filesystem
  and adds/updates records; prune (--prune) queries database and removes stale
  records. These are mutually exclusive operations.

Options:
  --force      Refresh mode: refresh all files. Prune mode: remove all records
               in scope unconditionally.
  --all        Operate on all files under /volumes instead of just current directory
  --dry-run    Preview changes without modifying database
  --xxhash     Verify file integrity using xxhash (also calculates/stores xxhash
               during refresh)
  --prune      Enter prune mode (remove stale records instead of refreshing)
  --help       Display this help message

Examples:
  refresh_metadata              Refresh current directory, skip existing
  refresh_metadata --force      Force refresh all files in current directory
  refresh_metadata --all        Refresh all files under /volumes
  refresh_metadata --prune      Remove records for deleted files in current dir
  refresh_metadata --prune --all --force   Remove all records from database

HELP;
    exit(0);
}

$force = isset($options['force']);
$all = isset($options['all']);
$dryRun = isset($options['dry-run']);
$checkXxhash = isset($options['xxhash']);
$prune = isset($options['prune']);

// Determine target directory
$root = realpath('/var/www/html/volumes');
$targetDir = $all ? $root : getcwd();

// Handle prune mode
if ($prune) {
    echo "Pruning stale database records...\n";
    
    $metaDb = new MetadataDatabase();
    $pruned = 0;
    $checked = 0;
    
    // Get all records from database
    $stmt = $metaDb->query('SELECT id, file_path, xxhash FROM files');
    
    while ($row = $stmt->fetchArray(SQLITE3_ASSOC)) {
        $dbFilePath = $row['file_path'];
        $filename = basename($dbFilePath);
        
        // Check if record is in scope
        $inScope = false;
        if ($all) {
            $inScope = (strpos($dbFilePath, $root) === 0);
        } else {
            $inScope = (strpos($dbFilePath, $targetDir) === 0);
        }
        
        if (!$inScope) {
            continue;
        }
        
        $checked++;
        $shouldPrune = false;
        $reason = '';
        
        if ($force) {
            $shouldPrune = true;
            $reason = 'force';
        } else {
            // Check if file exists
            if (!file_exists($dbFilePath)) {
                $shouldPrune = true;
                $reason = 'missing';
            } elseif ($checkXxhash) {
                // Check xxhash
                $dbXxhash = $row['xxhash'] ?? null;
                if ($dbXxhash) {
                    $currentXxhashOutput = Utils::executeCommand('xxhsum ' . escapeshellarg($dbFilePath));
                    $currentXxhash = null;
                    if ($currentXxhashOutput) {
                        $parts = explode(' ', trim($currentXxhashOutput));
                        $currentXxhash = $parts[0] ?? null;
                    }
                    if ($currentXxhash !== $dbXxhash) {
                        $shouldPrune = true;
                        $reason = 'xxhash mismatch';
                    }
                } else {
                    $shouldPrune = true;
                    $reason = 'xxhash missing';
                }
            }
        }
        
        if ($shouldPrune) {
            if ($dryRun) {
                echo "[$checked] $filename - Would prune ($reason) [DRY RUN]\n";
                $pruned++;
            } else {
                try {
                    $metaDb->deleteMetadata($dbFilePath);
                    echo "[$checked] $filename - Pruned ($reason)\n";
                    $pruned++;
                } catch (Exception $e) {
                    echo "[$checked] $filename - Failed to prune: " . $e->getMessage() . "\n";
                }
            }
        }
    }
    
    echo "\n";
    if ($dryRun) {
        echo "Dry run complete. Would prune $pruned of $checked records.\n";
    } else {
        echo "Pruning complete. Removed $pruned of $checked records.\n";
    }
    
    exit(0);
}

echo "Scanning " . ($all ? "all files under /volumes" : "current directory") . "...\n";

// Get all files
$files = [];
if ($all) {
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($targetDir, RecursiveDirectoryIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST
    );
    foreach ($iterator as $file) {
        if ($file->isFile()) {
            $path = $file->getPathname();
            // Skip if any directory component or filename starts with "."
            $parts = explode('/', $path);
            $shouldSkip = false;
            foreach ($parts as $part) {
                if (strlen($part) > 0 && $part[0] === '.') {
                    $shouldSkip = true;
                    break;
                }
            }
            if (!$shouldSkip) {
                $files[] = $path;
            }
        }
    }
} else {
    foreach (scandir($targetDir) as $f) {
        if ($f !== '.' && $f !== '..' && $f[0] !== '.' && is_file($targetDir . '/' . $f)) {
            $files[] = $targetDir . '/' . $f;
        }
    }
}

$total = count($files);
echo "Found $total files to check.\n\n";

if ($total === 0) {
    echo "No files found.\n";
    exit(0);
}

$metaDb = new MetadataDatabase();
$refreshed = 0;
$skipped = 0;
$failed = 0;
$errors = [];

foreach ($files as $i => $fsPath) {
    $num = $i + 1;
    $filename = basename($fsPath);
    
    // Convert to web path
    $webPath = '/volumes' . str_replace($root, '', $fsPath);
    
    // Check if refresh is needed
    $needsRefresh = false;
    $reason = '';
    
    if ($force) {
        $needsRefresh = true;
        $reason = 'force';
    } else {
        $metadata = $metaDb->getMetadata($webPath, $fsPath);
        
        if (!$metadata) {
            $needsRefresh = true;
            $reason = 'missing';
        } elseif ($checkXxhash) {
            // Check if xxhash has changed
            $dbXxhash = $metadata['xxhash'] ?? null;
            if ($dbXxhash) {
                $currentXxhashOutput = Utils::executeCommand('xxhsum ' . escapeshellarg($fsPath));
                $currentXxhash = null;
                if ($currentXxhashOutput) {
                    $xxhashParts = explode(' ', trim($currentXxhashOutput));
                    $currentXxhash = $xxhashParts[0] ?? null;
                }
                if ($currentXxhash !== $dbXxhash) {
                    $needsRefresh = true;
                    $reason = 'xxhash mismatch';
                }
            } else {
                // No xxhash stored, needs refresh
                $needsRefresh = true;
                $reason = 'xxhash missing';
            }
        }
        // If not force and metadata exists (and no xxhash check or xxhash matches), skip
        if (!$needsRefresh) {
            $skipped++;
            continue;
        }
    }
    
    if ($dryRun) {
        echo "[$num/$total] $filename - Would refresh ($reason) [DRY RUN]\n";
        $refreshed++;
        continue;
    }
    
    // Determine file type
    $ext = strtolower(pathinfo($fsPath, PATHINFO_EXTENSION));
    $textExtensions = ['txt', 'nfo', 'sfv', 'md', 'log', 'json', 'xml', 'csv', 'yaml', 'yml', 'conf', 'cfg', 'ini'];
    $isText = in_array($ext, $textExtensions);
    
    try {
        // Delete existing metadata
        $metaDb->deleteMetadata($fsPath);
        
        if ($isText) {
            // Text file metadata
            $output = [
                'file' => basename($fsPath),
                'folder' => basename(dirname($fsPath)),
                'filesize' => filesize($fsPath),
                'text' => ['encoding' => 'utf-8'],
                'optimizationStatus' => ['isOptimized' => true, 'issues' => []]
            ];
            $metaDb->saveMetadata($webPath, $fsPath, $output);
            echo "[$num/$total] $filename - Refreshed (text)\n";
            $refreshed++;
        } else {
            // Video file metadata
            $cmd = [
                'ffprobe',
                '-v', 'quiet',
                '-print_format', 'json',
                '-show_format',
                '-show_streams',
                $fsPath
            ];

            $descriptors = [
                0 => ['pipe', 'r'],
                1 => ['pipe', 'w'],
                2 => ['pipe', 'w'],
            ];

            $proc = proc_open($cmd, $descriptors, $pipes);

            if (is_resource($proc)) {
                $output = stream_get_contents($pipes[1]);
                fclose($pipes[1]);
                fclose($pipes[2]);
                proc_close($proc);

                $raw = $output;
            } else {
                $raw = '';
            }
            
            if ($raw && $meta = json_decode($raw, true)) {
                $video = null;
                $audio = null;
                
                foreach ($meta['streams'] ?? [] as $stream) {
                    if ($stream['codec_type'] === 'video' && !$video) {
                        $video = $stream;
                    }
                    if ($stream['codec_type'] === 'audio' && !$audio) {
                        $audio = $stream;
                    }
                }
                
                // Calculate optimization status
                $isOptimized = true;
                $issues = [];
                
                $nonStreamingContainers = ['avi', 'flv', 'wmv', 'mkv', 'mpeg', 'mpg'];
                if (in_array($ext, $nonStreamingContainers)) {
                    $isOptimized = false;
                    $issues[] = 'Non-streaming container: ' . strtoupper($ext);
                }
                
                $nonStreamingCodecs = ['wmv3', 'flv1', 'wmv2', 'mpeg4', 'wmv1', 'mpeg1video'];
                if ($video && in_array($video['codec_name'] ?? '', $nonStreamingCodecs)) {
                    $isOptimized = false;
                    $issues[] = 'Non-streaming codec: ' . ($video['codec_name'] ?? 'unknown');
                }
                
                // Check faststart for MP4/MOV/M4V
                if (in_array($ext, ['mp4', 'mov', 'm4v'])) {
                    $hasFaststart = null;
                    $fh = fopen($fsPath, 'rb');
                    if ($fh) {
                        while (!feof($fh)) {
                            $header = fread($fh, 8);
                            if (strlen($header) < 8) break;
                            list(, $size) = unpack('N', substr($header, 0, 4));
                            $type = substr($header, 4, 4);
                            if ($type === 'moov') { $hasFaststart = true; break; }
                            if ($type === 'mdat') { $hasFaststart = false; break; }
                            if ($size === 0) break;
                            if ($size === 1) { fseek($fh, 8, SEEK_CUR); }
                            else { fseek($fh, $size - 8, SEEK_CUR); }
                        }
                        fclose($fh);
                        if ($hasFaststart === false) {
                            $isOptimized = false;
                            $issues[] = 'Faststart not enabled (moov atom not at start)';
                        }
                    }
                }
                
                // Calculate FPS
                $fps = null;
                if ($video && isset($video['avg_frame_rate']) && $video['avg_frame_rate'] !== '0/0') {
                    $fpsParts = explode('/', $video['avg_frame_rate']);
                    if (count($fpsParts) === 2 && $fpsParts[1] != 0) {
                        $fps = (float)$fpsParts[0] / (float)$fpsParts[1];
                    }
                }
                
                $output = [
                    'file' => basename($fsPath),
                    'folder' => basename(dirname($fsPath)),
                    'filesize' => filesize($fsPath),
                    'duration' => $meta['format']['duration'] ?? null,
                    'bitrate' => isset($meta['format']['bit_rate']) ? (int)$meta['format']['bit_rate'] : null,
                    'container' => $meta['format']['format_name'] ?? null,
                    'video' => $video ? [
                        'codec' => $video['codec_name'] ?? null,
                        'width' => $video['width'] ?? null,
                        'height' => $video['height'] ?? null,
                        'fps' => $fps,
                        'pix_fmt' => $video['pix_fmt'] ?? null,
                    ] : null,
                    'audio' => $audio ? [
                        'codec' => $audio['codec_name'] ?? null,
                        'channels' => $audio['channels'] ?? null,
                        'sample_rate' => $audio['sample_rate'] ?? null,
                    ] : null,
                    'optimizationStatus' => [
                        'isOptimized' => $isOptimized,
                        'issues' => $issues
                    ],
                ];
                
                $metaDb->saveMetadata($webPath, $fsPath, $output);
                echo "[$num/$total] $filename - Refreshed (video)\n";
                $refreshed++;
            } else {
                throw new Exception("Failed to extract metadata");
            }
        }
    } catch (Exception $e) {
        $failed++;
        $errors[] = "$filename: " . $e->getMessage();
        echo "[$num/$total] $filename - Failed\n";
    }
}

echo "\n";
if ($dryRun) {
    echo "Dry run complete. $refreshed files would be refreshed, $skipped up to date, $failed failed.\n";
} else {
    echo "Refresh complete. $refreshed files refreshed, $skipped up to date, $failed failed.\n";
}

if (!empty($errors)) {
    echo "\nErrors encountered:\n";
    foreach ($errors as $error) {
        echo "  - $error\n";
    }
}
