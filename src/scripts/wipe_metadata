#!/usr/bin/env bash

DB_PATH="$(dirname "$0")/../../db/metadata.db"

# Check if the main database file exists before attempting to remove it
if [[ -f "$DB_PATH" ]]; then
  # Remove the database and its journal files safely
  rm -f "${DB_PATH}" "${DB_PATH}-shm" "${DB_PATH}-wal"
  echo "$(date '+%Y-%m-%d %H:%M:%S') - Metadata database and journal files wiped successfully."
else
  echo "Metadata database does not exist at $DB_PATH."
fi
