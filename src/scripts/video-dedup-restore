#!/bin/bash
# video-dedup-restore - Restore files from .deduped folder
# Usage: video-dedup-restore <path>

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VIDEO_DEDUP_DIR="$(dirname "$SCRIPT_DIR")"

# Detect if path is provided or not
if [ -z "$1" ] || [[ "$1" == -* ]]; then
    user_path="."
else
    user_path="$1"
    shift
fi

current_dir="$(pwd)"

# Translate path: . or ./ -> current directory
if [ "$user_path" = "." ] || [ "$user_path" = "./" ]; then
    user_path="$current_dir"
fi

# Replace /var/www/html/volumes with /videos
translated_path="${user_path//\/var\/www\/html\/volumes/\/videos}"

# Execute inside container
docker exec -i xclusive-video-dedup-1 \
    python /opt/video-dedup/scripts/dedup_restore.py \
    "$translated_path" "$@"

refresh_metadata --all --prune --refresh --include-audit-db