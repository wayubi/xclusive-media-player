#!/bin/bash
# video-dedup-delete - Delete duplicate files marked as DELETE_CANDIDATE
# Usage: video-dedup-delete <path> [--confirm]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VIDEO_DEDUP_DIR="$(dirname "$SCRIPT_DIR")"

exec docker compose -f "$VIDEO_DEDUP_DIR/compose.yml" -f "$VIDEO_DEDUP_DIR/compose.override.yml" exec video-dedup python /opt/video-dedup/scripts/dedup_delete.py "$@"