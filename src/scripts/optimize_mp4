#!/usr/bin/env bash
shopt -s nullglob

# MP4/MOV Optimizer
# Adds faststart flag and optionally strips metadata

# Help function
show_help() {
  cat << 'EOF'
MP4/MOV Optimizer
=================

Optimizes MP4, M4V, and MOV files by adding faststart for web streaming
and optionally stripping metadata.

USAGE:
    optimize_mp4 [FILE] [OPTIONS]

    optimize_mp4                           # Optimize all files in directory
    optimize_mp4 video.mp4                 # Optimize specific file
    optimize_mp4 --strip-metadata          # Strip metadata from all files
    optimize_mp4 video.mp4 --strip-metadata # Strip metadata from one file

OPTIONS:
    <file>                    Specific file to optimize (optional)
                              If provided, only this file will be processed
                              Supported: .mp4, .m4v, .mov
    
    --strip-metadata          Strip all metadata from files
                              Without this flag, only faststart is applied
    
    --dry-run                 Preview what would be optimized without modifying files
    
    --help                    Show this help message

WHAT IT DOES:
=============

Faststart Optimization:
    Moves the 'moov' atom (metadata) to the beginning of the file,
    allowing videos to start playing before the entire file is downloaded.
    Essential for web streaming.

Metadata Stripping:
    Removes all metadata tags (title, artist, encoder, etc.) using
    -map_metadata -1. This creates cleaner files with no identifying
    information.

SMART PROCESSING:
=================

The script checks each file before processing:

• If a file already has faststart and doesn't need metadata stripped,
  it is skipped entirely (no file movement or reprocessing).

• If --strip-metadata is NOT provided:
  - Only adds faststart if missing
  - Skips files that already have faststart
  - Does NOT strip metadata

• If --strip-metadata IS provided:
  - Strips metadata if any exists
  - Adds faststart if missing
  - Can do both in a single operation if needed

OUTPUT:
=======

• Optimized files: Same filename, in-place replacement
• Originals moved to: .trash-<timestamp>/
• Failed optimizations logged to: optimize_mp4_errors.log
• Metadata automatically refreshed after optimization

EXAMPLES:
=========

    # Faststart optimization only (default behavior)
    optimize_mp4                           # All MP4/MOV/M4V files
    optimize_mp4 video.mp4                 # Single file
    
    # Strip metadata (includes faststart fix if needed)
    optimize_mp4 --strip-metadata          # All files
    optimize_mp4 video.mp4 --strip-metadata # Single file
    
    # Preview what would happen
    optimize_mp4 --dry-run
    optimize_mp4 --strip-metadata --dry-run

REQUIREMENTS:
=============

• ffmpeg
• ffprobe
• refresh_metadata (custom tool for metadata updates)

EOF
  exit 0
}

# Supported extensions
ALL_EXTENSIONS=("mp4" "m4v" "mov")

# Function to check if extension is supported
check_extension() {
  local filename="$1"
  local ext="${filename##*.}"
  ext=$(echo "$ext" | tr '[:upper:]' '[:lower:]')
  
  for valid_ext in "${ALL_EXTENSIONS[@]}"; do
    if [[ "$ext" == "$valid_ext" ]]; then
      return 0
    fi
  done
  return 1
}

# Function to read N bytes from file at offset
# Returns hex string
read_bytes() {
  local file="$1"
  local offset="$2"
  local count="$3"
  
  dd if="$file" bs=1 skip="$offset" count="$count" 2>/dev/null | xxd -p | tr -d '\n'
}

# Function to convert big-endian hex to decimal
hex_to_dec() {
  printf "%d" "0x$1" 2>/dev/null || echo "0"
}

# Function to convert hex to ASCII string
hex_to_ascii() {
  echo "$1" | xxd -r -p 2>/dev/null
}

# Function to check if file needs faststart optimization
# Returns 0 if needs faststart (mdat before moov)
# Returns 1 if already has faststart (moov before mdat)
needs_faststart() {
  local file="$1"
  local offset=0
  local file_size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo "0")
  
  [[ "$file_size" -eq 0 ]] && return 0
  
  while [[ $offset -lt $file_size ]]; do
    # Read 8-byte atom header
    local header=$(read_bytes "$file" "$offset" 8)
    
    # Check if we got enough bytes
    [[ ${#header} -lt 16 ]] && break
    
    # Parse size (first 4 bytes, big-endian)
    local size_hex="${header:0:8}"
    local size=$(hex_to_dec "$size_hex")
    
    # Parse type (next 4 bytes)
    local type_hex="${header:8:8}"
    local type=$(hex_to_ascii "$type_hex")
    
    # Check atom type
    if [[ "$type" == "moov" ]]; then
      return 1  # Has faststart (moov found before mdat)
    fi
    
    if [[ "$type" == "mdat" ]]; then
      return 0  # Needs faststart (mdat before moov)
    fi
    
    # Calculate next atom offset
    if [[ "$size" -eq 0 ]]; then
      break  # Invalid size
    elif [[ "$size" -eq 1 ]]; then
      # Extended 64-bit size - read next 8 bytes
      local ext_header=$(read_bytes "$file" $((offset + 8)) 8)
      if [[ ${#ext_header} -ge 16 ]]; then
        # Parse 64-bit size (big-endian)
        local high=$(hex_to_dec "${ext_header:0:8}")
        local low=$(hex_to_dec "${ext_header:8:8}")
        # Use low 32 bits for simplicity (handles files up to 4GB)
        size=$((low))
        offset=$((offset + 16 + size - 16))
      else
        break
      fi
    else
      offset=$((offset + size))
    fi
  done
  
  # If we didn't find either atom, assume it needs faststart
  return 0
}

# Function to check if file has meaningful format-level metadata (not stream metadata)
# Only checks container-level metadata (title, artist, etc.) not stream metadata (handler_name, vendor_id)
has_metadata() {
  local file="$1"
  
  # Only check format/container-level metadata using ffprobe
  # Stream metadata (handler_name, vendor_id, encoder) is ignored
  local format_tags=$(ffprobe -v error -show_format "$file" 2>/dev/null | grep -E '^TAG:')
  
  # Check for any tags that aren't technical/encoder tags
  while IFS= read -r line; do
    # Extract tag name (everything between TAG: and =)
    if [[ "$line" =~ ^TAG:([^=]+)=(.+)$ ]]; then
      local tag_name="${BASH_REMATCH[1]}"
      local tag_value="${BASH_REMATCH[2]}"
      
      # Skip technical/encoder tags - these remain even after -map_metadata -1
      case "$tag_name" in
        encoder|minor_version|major_brand|compatible_brands)
          continue
          ;;
        *)
          # Any other tag with content counts as metadata (title, artist, etc.)
          if [[ -n "$tag_value" ]]; then
            return 0  # Has metadata
          fi
          ;;
      esac
    fi
  done <<< "$format_tags"
  
  return 1  # No metadata (or only technical tags)
}

# Parse arguments
SINGLE_FILE=""
STRIP_METADATA=false
DRY_RUN=false

while [[ $# -gt 0 ]]; do
  case $1 in
    --help|-h)
      show_help
      ;;
    --strip-metadata)
      STRIP_METADATA=true
      shift
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    -*)
      echo "Unknown option: $1"
      echo "Usage: $0 [FILE] [--strip-metadata] [--dry-run] [--help]"
      echo "Try '$0 --help' for more information."
      exit 1
      ;;
    *)
      # Check if this is a file path
      if [[ -f "$1" ]]; then
        if check_extension "$1"; then
          SINGLE_FILE="$1"
          shift
        else
          echo "Error: File '$1' has an unsupported extension."
          echo "Supported extensions: ${ALL_EXTENSIONS[*]}"
          exit 1
        fi
      else
        echo "Error: '$1' is not a valid file or option."
        echo "Usage: $0 [FILE] [--strip-metadata] [--dry-run] [--help]"
        exit 1
      fi
      ;;
  esac
done

# Build file list
if [[ -n "$SINGLE_FILE" ]]; then
  files=("$SINGLE_FILE")
  echo "Processing single file: $SINGLE_FILE"
else
  # Batch mode
  files=()
  for ext in "${ALL_EXTENSIONS[@]}"; do
    pattern="*.$ext *.${ext^^}"
    for f in $pattern; do
      [[ -f "$f" ]] && files+=("$f")
    done
  done
  
  if (( ${#files[@]} == 0 )); then
    echo "No MP4/MOV/M4V files found. Nothing to do."
    exit 0
  fi
  
  echo "Found ${#files[@]} file(s) to process"
fi

echo ""

if [[ "$DRY_RUN" == true ]]; then
  echo "DRY RUN MODE - No files will be modified"
  echo ""
fi

# Setup - trashDir will be created lazily only when needed
trashDir=""
log="optimize_mp4_errors.log"

# Counters for summary
processed=0
skipped=0
failed=0

# Process each file
for f in "${files[@]}"; do
  # Skip if file doesn't exist
  [[ -f "$f" ]] || continue
  
  base="${f%.*}"
  ext="${f##*.}"
  
  echo "Checking: $f"
  
  # Detect what needs to be done
  needs_fs=false
  needs_strip=false
  
  if needs_faststart "$f"; then
    needs_fs=true
  fi
  
  if [[ "$STRIP_METADATA" == true ]] && has_metadata "$f"; then
    needs_strip=true
  fi
  
  # Determine action
  if [[ "$needs_fs" == false && "$needs_strip" == false ]]; then
    echo "  → Already optimized, skipping"
    ((skipped++))
    echo ""
    continue
  fi
  
  # Build action description
  action=""
  if [[ "$needs_fs" == true && "$needs_strip" == true ]]; then
    action="faststart + metadata strip"
  elif [[ "$needs_fs" == true ]]; then
    action="faststart"
  else
    action="metadata strip"
  fi
  
  echo "  → Needs: $action"
  
  if [[ "$DRY_RUN" == true ]]; then
    echo "  [DRY RUN] Would optimize with: $action"
    ((processed++))
    echo ""
    continue
  fi
  
  # Create trash directory lazily only when needed
  if [[ -z "$trashDir" ]]; then
    trashDir=".trash-$(date +%s)"
    mkdir -p "$trashDir"
  fi
  
  # Build ffmpeg command - use array to properly handle special characters in filenames
  ffmpeg_cmd=(ffmpeg -nostdin -hide_banner -loglevel error -i "$f")
  
  # Always copy streams (no re-encoding)
  ffmpeg_cmd+=(-c:v copy -c:a copy)
  
  # Add faststart if needed (always needed when stripping metadata, as it causes loss of faststart)
  if [[ "$STRIP_METADATA" == true || "$needs_fs" == true ]]; then
    ffmpeg_cmd+=(-movflags +faststart)
  fi
  
  # Strip metadata if needed
  if [[ "$needs_strip" == true ]]; then
    ffmpeg_cmd+=(-map_metadata -1)
  fi
  
  ffmpeg_cmd+=(".tmp.${base}.${ext}")
  
  # Execute optimization
  if "${ffmpeg_cmd[@]}"; then
    # Move original to trash first, then rename .tmp file to final name
    mv "$f" "${trashDir}/${base}.${ext}"
    mv ".tmp.${base}.${ext}" "./${base}.${ext}"
    touch -r "${trashDir}/${base}.${ext}" "./${base}.${ext}"
    echo "  ✓ Optimized: ${base}.${ext}"
    ((processed++))
  else
    echo "  ERROR: Optimization failed"
    echo "FAILED: $f" >> "$log"
    # Clean up partial .tmp file
    [[ -f ".tmp.${base}.${ext}" ]] && rm -f ".tmp.${base}.${ext}"
    ((failed++))
  fi
  
  echo ""
done

# Summary
echo "========================================"
if [[ "$DRY_RUN" == true ]]; then
  echo "Dry run complete!"
  echo "Would process: $processed file(s)"
  echo "Would skip: $skipped file(s)"
else
  echo "Optimization complete!"
  echo "Processed: $processed file(s)"
  echo "Skipped: $skipped file(s)"
  if (( failed > 0 )); then
    echo "Failed: $failed file(s) (see $log)"
  fi
  
  # Only show trash folder message if it was created
  if [[ -n "$trashDir" && -d "$trashDir" ]]; then
    echo "Original files moved to: $trashDir"
  fi
  
  # Refresh metadata if we processed any files
  if (( processed > 0 )); then
    echo ""
    echo "Refreshing metadata for optimized files..."
    if [[ -n "$SINGLE_FILE" ]]; then
      refresh_metadata "$SINGLE_FILE" --xxhash
    else
      refresh_metadata --xxhash
    fi
    
    echo ""
    echo "Pruning stale database records..."
    refresh_metadata --prune
  fi
fi
